<Window x:Class="TrainController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrainController"
        xmlns:models="clr-namespace:TrainController.Models"       
        
        Title="Train Controller" Height="450" Width="800"
        
        >
    <Window.DataContext>
        <models:MainVM/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="MenuStyle" TargetType="Menu">
            <Setter Property="Foreground" Value="Yellow"/>
            <Setter Property="Background" Value="DarkBlue"/>
        </Style>
    </Window.Resources>
        <Grid x:Name="MainGrid" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" 
              Margin="0,0,10,6" RenderTransformOrigin="0.5,0.5">
        <Menu Style="{StaticResource MenuStyle}" Height="23" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="OpenFile_Click" Foreground="Black" />
                <MenuItem Header="_Save" Click="SaveFile_Click" Foreground="Black"/>
                <MenuItem Header="Neues Projekt" Click="NewProject_Click" />
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click" Foreground="Black"/>
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="...Neues Projekt" Click="NewProject_Click" Foreground="Black" IsCheckable="False"/>                
            </MenuItem>            
            <MenuItem Header="Ebenen">
                <MenuItem Header="Raster Anzeigen" Click="ShowLayer_Click" Foreground="Black" IsCheckable="True"
                        x:Name="ItemRaster" 
                        IsChecked="{Binding ShowLayer, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding EnableControls, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </MenuItem>            
        </Menu>

        <UserControl x:Name="usercontrl">
            
        </UserControl>   
    </Grid>
</Window>
