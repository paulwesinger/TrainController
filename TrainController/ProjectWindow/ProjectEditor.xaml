<UserControl x:Class="TrainController.ProjectWindow.ProjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.ProjectWindow"
             xmlns:model="clr-namespace:TrainController.Models"
             xmlns:tools="clr-namespace:TrainController.Dialogs"
             xmlns:usrctls="clr-namespace:TrainController.UserControls"             
             xmlns:menuitems="clr-namespace:TrainController.MenuItems"
             mc:Ignorable="d" 
             Background="Black"
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="450"
             MinWidth="800"
             Loaded="UserControl_Loaded"
            >
    <UserControl.Resources>
        <model:ProjectWinModel x:Key="projectmodel"/>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="39"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="657*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Column="1">
            <Canvas x:Name="mycanvas" Grid.Column="1" Visibility="Visible"  AllowDrop="True"
                MouseLeftButtonDown="mycanvas_MouseLeftButtonDown" MouseLeftButtonUp="mycanvas_MouseLeftButtonUp"/>
        </ScrollViewer>

        <StackPanel Orientation="Vertical" Margin="5,60,5,0" Background="DarkBlue" VerticalAlignment="Top" Height="346">

            <TreeView x:Name="trvTracks" Height="360" Background="Black" Foreground="Wheat" DataContext="{DynamicResource projectmodel}"
                      ItemsSource="{Binding RootNode}" Width="142" >
                <TreeView.Resources>                    
                    <HierarchicalDataTemplate DataType="{x:Type menuitems:TreeviewMenuItems}" ItemsSource="{Binding Childs}">
                        <!--<StackPanel Orientation="Vertical">
                            <TextBox Text="{Binding Header}"/>-->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Elementlabel}" Foreground="AliceBlue" HorizontalAlignment="Left"/>
                                <ContentControl Content="{Binding uiElement}" Height="20"/>
                            </StackPanel>
                        <!--</StackPanel>-->
                    </HierarchicalDataTemplate>
                </TreeView.Resources> 
            </TreeView>

            <TextBox Text="Root" Foreground="Yellow"/>
            <!--<TreeView x:Name="trvMenu">
                <TreeView.ItemTemplate>
                    <HierachialDataTemplate DataType="{x:Type TreeviewMenuItems}" ItemsSource="{Binding Childs}"/>
                </TreeView.ItemTemplate>
                
            </TreeView>-->
        </StackPanel>
    </Grid>
</UserControl>
