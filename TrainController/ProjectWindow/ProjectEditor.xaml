<UserControl x:Class="TrainController.ProjectWindow.ProjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.ProjectWindow"
             xmlns:model="clr-namespace:TrainController.Models"
             xmlns:tools="clr-namespace:TrainController.Dialogs"
             xmlns:usrctls="clr-namespace:TrainController.UserControls"             
             mc:Ignorable="d" 
             Background="Black"
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="450"
             MinWidth="800"
            >

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="39"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="657*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Column="1">
            <Canvas x:Name="mycanvas" Grid.Column="1" Visibility="Visible"  AllowDrop="True"
                MouseLeftButtonDown="mycanvas_MouseLeftButtonDown" MouseLeftButtonUp="mycanvas_MouseLeftButtonUp"/>
        </ScrollViewer>

        <StackPanel Orientation="Vertical" Margin="5,5,5,5" Background="DarkBlue">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Width="120" HorizontalAlignment="Left" Margin="2">
                <usrctls:SchieneGerade Margin="2"/>
                <usrctls:SchieneGerade Margin="2"/>
            </StackPanel>
            <StackPanel  Grid.Column="0" Orientation="Horizontal" Width="70" HorizontalAlignment="Left" Margin="2">
                <usrctls:SiemensGeradeH Margin="2"/>
                <usrctls:SiemensHtoRightUp Margin="2"/>
            </StackPanel>
            <StackPanel  Grid.Column="0" Orientation="Horizontal" Width="70" HorizontalAlignment="Left" Margin="2">
                <Image Source="/Images/SmallLogo.png" Width="32" Height="32" Margin="2"/>
                <Image Source="/Images/SmallLogoCanary.png" Width="32" Height="32" Margin="2"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
