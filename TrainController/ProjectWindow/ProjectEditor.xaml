<UserControl x:Class="TrainController.ProjectWindow.ProjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.ProjectWindow"
             xmlns:model="clr-namespace:TrainController.Models"
             xmlns:tools="clr-namespace:TrainController.Dialogs"
             mc:Ignorable="d" 
             Background="#FF7D91A0"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="17*"/>
        </Grid.ColumnDefinitions>
        <Canvas x:Name="mycanvas" Grid.ColumnSpan="1" Grid.Column="1" Visibility="Visible">
        </Canvas>
        <StackPanel Orientation="Vertical" Margin="5">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Width="70" HorizontalAlignment="Left" Margin="2">
                <Image Source="/Images/Logo.png" Width="32" Height="32" Margin="2"  Visibility="Visible"/>
                <Image Source="/Images/LogoBeta.png" Width="32" Height="32" Margin="2"/>
            </StackPanel>
            <StackPanel  Grid.Column="0" Orientation="Horizontal" Width="70" HorizontalAlignment="Left" Margin="2">
                <Image Source="/Images/LogoCanary.png" Width="32" Height="32" Margin="2"/>
                <Image Source="/Images/LogoDev.png" Width="32" Height="32" Margin="2"/>
            </StackPanel>
            <StackPanel  Grid.Column="0" Orientation="Horizontal" Width="70" HorizontalAlignment="Left" Margin="2">
                <Image Source="/Images/SmallLogo.png" Width="32" Height="32" Margin="2"/>
                <Image Source="/Images/SmallLogoCanary.png" Width="32" Height="32" Margin="2"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
