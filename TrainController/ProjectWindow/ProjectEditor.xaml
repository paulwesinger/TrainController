<UserControl x:Class="TrainController.ProjectWindow.ProjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.ProjectWindow"
             xmlns:model="clr-namespace:TrainController.Models"
             xmlns:tools="clr-namespace:TrainController.Dialogs"
             xmlns:usrctls="clr-namespace:TrainController.UserControls"             
             xmlns:menuitems="clr-namespace:TrainController.MenuItems"
             mc:Ignorable="d" 
             Background="Black"
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="450"
             MinWidth="800"
             Loaded="UserControl_Loaded"
            >
    <UserControl.Resources>
        <model:ProjectWinModel x:Key="projectmodel"/>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="39"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="321*"/>
            <ColumnDefinition Width="479*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Column="1">
            <Canvas x:Name="mycanvas" Grid.Column="1" Visibility="Visible"  AllowDrop="True"
                MouseLeftButtonDown="mycanvas_MouseLeftButtonDown" MouseLeftButtonUp="mycanvas_MouseLeftButtonUp"/>
        </ScrollViewer>      

            <!--<TreeView x:Name="trvTracks" Height="346" Background="Black" Foreground="Wheat" DataContext="{DynamicResource projectmodel}"
                      ItemsSource="{Binding RootNode}" Width="141" HorizontalAlignment="Left" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type menuitems:TreeviewMenuItems}" ItemsSource="{Binding Childs}">
                        --><!--<StackPanel Orientation="Vertical">
                            <TextBox Text="{Binding Header}"/>--><!--
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Elementlabel}" Foreground="AliceBlue" HorizontalAlignment="Left" Grid.Column="0"/>
                            <ContentControl Content="{Binding uiElement}" Height="20" Grid.Column="1" HorizontalAlignment="Center"/>
                        </Grid>
                        --><!--</StackPanel>--><!--
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>-->
            <ListView Height="395" ItemsSource="{Binding Menuobjects}" x:Name="lvMenu">
            <ListView.DataContext >
                <model:ProjectWinModel></model:ProjectWinModel>
            </ListView.DataContext>
            <ListView.Resources>
                <DataTemplate DataType="{x:Type menuitems:MenuObjects}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TextElement}"/>
                        <ContentControl Content="{Binding ControlElement}"/>
                    </Grid>
                    
                    
                </DataTemplate>
            <!--     <DataTemplate DataType="{x:Type menuitems:MenuObjects}">
                    <DataGridColumnHeader>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TextElement}" Foreground="Wheat" Background="DimGray" Grid.Column="0"/>
                            <TextBox Text="Element"/>
                        </Grid>                     
                    </DataGridColumnHeader>
                </DataTemplate>-->
            </ListView.Resources>
            <ListView.View>                           

                    <GridView>
                        <GridViewColumn Header="Auswahl" Width="120" DisplayMemberBinding="{Binding TextElement}"/>
                        <GridViewColumn Header="Object" Width="150" DisplayMemberBinding="{Binding ControlElement}"/>

                </GridView>
                </ListView.View>
            </ListView>          
      
    </Grid>
</UserControl>
