<UserControl x:Class="TrainController.UserControls.SchieneGerade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.UserControls"
             xmlns:models="clr-namespace:TrainController.Models"
             xmlns:converter="clr-namespace:TrainController.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="32"
             Name="SchieneGerade_Horizontal"    
             Width="{Binding CntrlWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                         
                          >
    <UserControl.DataContext>
        <models:UserControlsVM/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <converter:BoolToVisibleConverter x:Key="booltovisibleconverter"/>
    </UserControl.Resources>
    <Grid>        
        <!--<Image x:Name="Schiene_Gerade" Source="/Images/Track_straight64x20.png"  Width="32" Height="20"/>-->
        <Rectangle Width="{Binding CntrlWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Height="20" Fill="Gray" Stroke="Gray" StrokeThickness="1"/>
        
        <Rectangle Width="{Binding CntrlWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StrokeThickness="1" Stroke="Black" Fill="Black" Height="8"/>

        <!--<local:MouseGrabber Visibility="{Binding Editing, Mode=TwoWay, 
                UpdateSourceTrigger=PropertyChanged,Converter={StaticResource booltovisibleconverter} }"
             Width="{Binding CntrlWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->

    </Grid>
</UserControl>
