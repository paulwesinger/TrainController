<UserControl x:Class="TrainController.UserControls.SchieneGerade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.UserControls"
             xmlns:converter="clr-namespace:TrainController.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="30"
             Name="SchieneGerade_Horizontal"    
             Width="{Binding CtlWidh, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"                                                   
             MinWidth="60"
             MaxWidth="800"
             >

    <Grid>
        <!--<Image x:Name="Schiene_Gerade" Source="/Images/Track_straight64x20.png"  Width="32" Height="20"/>-->
        <Rectangle Height="20" Fill="Gray" Stroke="Gray" StrokeThickness="1"/>

        <Rectangle StrokeThickness="1" Stroke="Black" Fill="Black" Height="8" Margin="0,6,0,6"/>

        <!--Anfasser f+r links, rechts mitte-->        
        
        <Thumb Width="8" HorizontalAlignment="Left" Cursor="SizeWE" Background="DarkBlue" Height="10"
               x:Name="ResizeThumbDelta"  DragDelta="ResizeThumbLeft" PreviewMouseLeftButtonDown="ResizeThumbLeftButtonDown"
               PreviewMouseLeftButtonUp="ResizeThumb_LeftButtonUp"
               Visibility="{Binding GrabberVisibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Thumb Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Background="DarkBlue" Height="10"
               x:Name="ResizeThumbDeltaRight"  DragDelta="ResizeThumbRight" PreviewMouseLeftButtonDown="ResizeThumbLeftButtonDown"
               PreviewMouseLeftButtonUp="ResizeThumb_LeftButtonUp"
               Visibility="{Binding GrabberVisibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>


    </Grid>
</UserControl>
