<UserControl x:Class="TrainController.UserControls.SiemensHtoRightUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainController.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="40"
             x:Name="SiemensHtoRightup"
             MinWidth="40" MinHeight="20"
             Background="Black">
    
    <Grid>
        <Line X1="0" Y1="10" X2="20" Y2="10" Stroke="LightBlue" StrokeThickness="3" x:Name="HLine"/>
        <Line X1="19" Y1="10" X2="40" Y2="0" Stroke="LightBlue" StrokeThickness="3" x:Name="Lineup"/>
    </Grid>
</UserControl>
